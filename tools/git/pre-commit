GIT_TOP="$(git rev-parse --show-toplevel)"
source "$GIT_TOP/tools/clang-format.sh"

case $(uname -s) in
Darwin)
    FORMAT=${FORMAT:-${ROOT}/clang-format/clang-format.osx}
    ;;
Linux)
    FORMAT=${FORMAT:-${ROOT}/clang-format/clang-format.linux}
    ;;
*)
    echo "Leif needs to build a clang-format for $(uname -s)"
    exit 2
esac

# If there is no clang-format in our git repo, then try from git config
[ ! -x "$FORMAT" ] && FORMAT=$(git config clangFormat.binary)

# Make sure we have some clang-format executable...
if [ ! -x "$FORMAT" ]; then
    echo "No clang-format found"
    exit 1
fi

# Check for uv which is required for Ruff.
if ! command -v uv &> /dev/null; then
    echo "uv is not installed. Please install it: https://docs.astral.sh/uv/getting-started/installation/"
    exit 1
fi

# Get the version variable from the formatting script.
source "$GIT_TOP/tools/ruff.sh"

# Where to store the patch
clang_patch_file=$(mktemp -t clang-format.XXXXXXXXXX)
ruff_patch_file=$(mktemp -t ruff.XXXXXXXXXX)
ruff_error_file=$(mktemp -t ruff-error.XXXXXXXXXX)
trap "rm -f $clang_patch_file $ruff_patch_file $ruff_error_file" 0 1 2 3 5 15

# Loop over all files that are changed, and produce a diff file
REPO_ROOT=${GIT_TOP}
RUFF_CONFIG=${REPO_ROOT}/ruff.toml
git diff-index --cached --diff-filter=ACMR --name-only HEAD | grep -vE "lib/yamlcpp" | while read file; do
    case "$file" in
	*.cc | *.c | *.h | *.h.in)
	    ${FORMAT} "$file" | diff -u "$file" - >> "$clang_patch_file"
	    ;;
        # Keep this list of Python extensions the same with the list of
        # extensions searched for in the tools/ruff.sh script.
        *.py | *.cli.ext | *.test.ext)
            uv tool run --quiet ruff@${RUFF_VERSION} format \
                --config "${RUFF_CONFIG}" \
                --diff \
                --quiet \
                "$file" >>"$ruff_patch_file"
            ruff_status=$?
            if [ "${ruff_status}" -gt 1 ]; then
                echo "Ruff failed while checking ${file}." >&2
                echo "${file}" >>"$ruff_error_file"
            fi
            ;;
    esac
done

if [ -s "$clang_patch_file" ] ; then
    echo "The commit is not accepted, because clang-format does not match current"
    echo "requirements. Easiest to fix this is to run:"
    echo
    echo "    $ make -j clang-format"
    exit 1
else
    echo "This commit complies with the current clang-format indentation rules."
    echo
fi

if [ -s "$ruff_patch_file" ] || [ -s "$ruff_error_file" ]; then
    echo "The commit is not accepted because Ruff reports issues with it."
    echo "The easiest way to fix this is to run:"
    echo
    echo "    $ make ruff"
    exit 1
else
    echo "This commit complies with the current Ruff formatting rules."
    echo
fi

# Cleanup before exit
rm -f "$clang_patch_file" "$ruff_patch_file" "$ruff_error_file"
exit 0
