set -u

test_directory=$(cd "$(dirname "$0")" && pwd)
source_directory=$(cd "${test_directory}" && cd "@srcdir@/.." && pwd)
build_directory=$(cd "${test_directory}/.." && pwd)
verifier_version=$(cat "${source_directory}/tests/proxy-verifier-version.txt")
configured_curl_uds=""
curl_uds_argument=()
if [ -n "${configured_curl_uds}" ]; then
  curl_uds_argument=(--configured-curl-uds)
fi

exec python3 "${source_directory}/tests/tools/uranium/runner.py" configured \
  "--source-root=${source_directory}" \
  "--build-root=${build_directory}" \
  "--install-prefix=@prefix@" \
  "--verifier-bin=${PROXY_VERIFIER_PATH:-${source_directory}/tests/proxy-verifier/unpack/${verifier_version}/bin}" \
  "--sandbox=${ATS_URTEST_SANDBOX:-/tmp/urtest-9-2}" \
  "--project-directory=${source_directory}/tests" \
  ${curl_uds_argument[@]+"${curl_uds_argument[@]}"} \
  -- "$@"
