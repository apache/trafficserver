records:
  config_update_interval_ms: 20  # default: 3000
  diags:
    debug:
      enabled: 1  # default: 0
      tags: rpc  # default: http|dns
  http:
    server_ports: ``  # default: 8080 8080:ipv6
    wait_for_cache: 1  # default: 0
  log:
    rolling_enabled: 0  # default: 1
  udp:
    threads: 1  # default: 0
